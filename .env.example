# Run deno task setup to generate local signing material and a device authorization key.
ARURA_PORT=4100
ARURA_PUBLIC_URL=http://localhost:5173
ARURA_AUTH_ISSUER=http://localhost:4100
ARURA_STATE_DIR=.state
CONVEX_URL=http://127.0.0.1:3210
CONVEX_PUBLIC_URL=http://localhost:3210
HERMES_URL=http://127.0.0.1:9119
# Set either a dashboard username/password, or a supported gateway token.
HERMES_USERNAME=
HERMES_PASSWORD=
# Optional when the host advertises more than one password authentication provider.
HERMES_AUTH_PROVIDER=
HERMES_TOKEN=
# Optional host-managed action definitions; see deployment documentation.
ARURA_ACTIONS_FILE=
